{
  "manifest_version": 3,
  "name": "Stash",
  "version": "1.0.0",
  "description": "Save the current page to your Stash queue",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stash this page"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
